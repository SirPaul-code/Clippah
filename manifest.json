{
  "manifest_version": 3,
  "name": "Clippah",
  "version": "0.1.0",
  "description": "Mark, capture and reframe clips directly where you watch video.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "storage", "tabCapture", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Arm / disarm Clippah capture" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+Shift+K" },
      "description": "Arm or disarm Clippah on the current tab"
    }
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
